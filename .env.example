# Copy to .env and fill in. .env is gitignored - never commit it.

# --- Server identity ---------------------------------------------------------
# Pinned to 26.1.2, not 26.2: CoreProtect (our undo + anti-grief rollback) has
# no 26.2 build yet. ViaVersion lets 26.2 clients join anyway, so nobody is
# locked out. Bump this once CoreProtect ships 26.2 support.
MC_VERSION=26.1.2
MC_HEAP=3G
MC_MEM_LIMIT=5G
MC_DIFFICULTY=normal
MC_MODE=survival
MC_MAX_PLAYERS=12
MC_MOTD=A server for a very good builder
TZ=Europe/London

# Where world data lives
MC_DATA=./minecraft-data

# User the containers run as. Must own MC_DATA.
PUID=1000
PGID=1000

# --- Who's in charge ---------------------------------------------------------
# Comma-separated Minecraft (Java) usernames.
# MC_OPS      = full admin. Put YOUR account here.
# MC_WHITELIST= allowed to join. Your kid's account goes here; they can then
#               add their own friends in-game with /whitelist add <name>.
MC_OPS=
MC_WHITELIST=

# --- Secrets -----------------------------------------------------------------
# Generate with: openssl rand -base64 24
RCON_PASSWORD=

# --- Backups -----------------------------------------------------------------
BACKUP_INTERVAL=6h
PRUNE_BACKUPS_DAYS=14

# --- AI build assistant ------------------------------------------------------
# LLM_BACKEND: openrouter | lmstudio
#
# openrouter -> your existing OpenRouter account. One key, any model.
# lmstudio   -> your MacBook's LM Studio over Tailscale. Free, but only works
#               while the laptop is awake.
LLM_BACKEND=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Generating a build plan is structured output, not hard reasoning, so the
# cheap model is the right default. Costs roughly a halfpenny per build.
#   moonshotai/kimi-k2.6  $0.58/M in, $2.44/M out   <- default
#   moonshotai/kimi-k3    $3.00/M in, $15.00/M out  <- 1M ctx, for ambitious builds
LLM_MODEL=moonshotai/kimi-k2.6

# For LLM_BACKEND=lmstudio - the machine running LM Studio, server on :1234
LMSTUDIO_BASE_URL=http://192.168.1.10:1234/v1
LMSTUDIO_MODEL=qwen/qwen3-coder-next

# --- AI safety envelope ------------------------------------------------------
AI_MAX_BLOCKS=400000
# Detailed builds legitimately use 200-300 ops; each is cheap to compile.
AI_MAX_OPS=400
AI_MAX_EXTENT=120
AI_MAX_BUILDS_PER_HOUR=20
AI_BUILD_COOLDOWN_SEC=10

# --- Web panel ---------------------------------------------------------------
# Password for the panel at http://<host>:8080. Generate one with:
#   openssl rand -base64 18
# Only needed for connections from OUTSIDE your home network - see
# WEB_LAN_NOAUTH below. Leave blank to have no password at all.
WEB_PASSWORD=

# Skip the login for clients on the local network (default: true). Docker
# preserves the real client address for published ports, so a machine on your
# LAN is recognised and a machine on the internet is not.
#
# Two caveats worth knowing:
#  - traffic arriving over a mesh VPN (Tailscale etc.) is NAT'd by the host and
#    shows up as the Docker bridge gateway (172.16.x.x), so it is trusted too.
#    That is fine for your own devices - but do NOT expose this port through a
#    public tunnel such as Tailscale Funnel while this is on.
#  - if you front the panel with a reverse proxy, every request will appear to
#    come from the proxy. Use WEB_TRUST_PROXY_HEADER instead in that case.
WEB_LAN_NOAUTH=true

# Narrow what counts as "local" if you want to be stricter, e.g. your LAN only:
#   WEB_TRUSTED_CIDRS=192.168.1.0/24
# Default: 127.0.0.0/8, 10/8, 172.16/12, 192.168/16, 169.254/16, 100.64/10
WEB_TRUSTED_CIDRS=

# Bind the panel to your LAN only by default. Use 0.0.0.0 to expose it more
# widely, but put it behind a reverse proxy with TLS if you do.
WEB_BIND=0.0.0.0
WEB_PUBLIC_PORT=8080

# If a reverse proxy already authenticates users (Authelia, oauth2-proxy,
# Cloudflare Access), name the header it sets and the panel will trust it
# instead of asking for a password, e.g. remote-user
WEB_TRUST_PROXY_HEADER=
